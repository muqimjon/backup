# Shell scripts and Dockerfiles run inside Linux containers — they MUST keep
# LF line endings regardless of the contributor's OS or core.autocrlf setting.
# A stray CRLF turns "#!/usr/bin/env bash" into "bash\r": "bad interpreter".
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
Makefile    text eol=lf
entrypoint  text eol=lf

# Copy to .env and fill in. NEVER commit the real .env.

# JWT signing key — MUST be at least 32 bytes. Generate a random one.
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-bytes

# Admin login for the web UI (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Shared token the agent uses to talk to the hub
HUB_TOKEN=change-me-to-a-random-token

# Agent identity
AGENT_NAME=local-agent
PROJECT_NAME=backuphub
TZ=Asia/Tashkent

# Optional — Google Drive OAuth (see docs/google-oauth.md). Leave blank to use S3 only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Grafana login (only used with the 'metrics' profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
